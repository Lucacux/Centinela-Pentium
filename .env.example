DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
SERVER_NAME=pentium
DEBUG_MODE=false
BACKUP_PATH=/path/to/backup
SAFE_SUBNETS=192.168.,10.,172.
WATCHED_SERVICES=service1,service2
# Servicios que !restart puede tocar. Nombres de SERVICIO, no de contenedor: bajo
# Swarm el nombre real lleva un task id que cambia en cada deploy y nunca
# matchearia. Vacio = sin lista blanca (cualquier servicio que exista se puede
# reiniciar); el nombre siempre se resuelve contra lo que Docker reporta, asi que
# vacio no significa que se pueda ejecutar cualquier cosa.
ALLOWED_RESTART=service1,service2
SSH_FAIL_THRESHOLD=10
SSH_FAIL_WINDOW=120
# Consulta las jails una vez/minuto y notifica IPs nuevas. Si el socket de
# fail2ban es root-only, cae automaticamente a `journalctl -u fail2ban`.
FAIL2BAN_ENABLED=true
# Cloudflare Zero Trust Access (opcional). El token necesita solamente
# "Access: Audit Logs Read". Para SSH/TCP el origin siempre ve a cloudflared;
# estos logs son la fuente autoritativa de usuario, IP publica observada y Ray ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_TOKEN=
CLOUDFLARE_ACCESS_APP=ssh.example.com
CLOUDFLARE_CORRELATION_SECONDS=180
# Geolocalizacion aproximada de IP publica, totalmente local. Descarga
# GeoLite2-Country.mmdb y apunta a ella. Si queda vacio, Centinela busca las
# rutas Linux habituales; nunca consulta una API GeoIP externa.
GEOIP_COUNTRY_DB=/var/lib/GeoIP/GeoLite2-Country.mmdb
GEOIP_COUNTRY_LOCALE=es
SWAP_ALERT_PCT=80
TEMP_ALERT_C=75
MANAGED_SERVICES=service1,service2

# --- Grafana (opcional): ver los paneles del dashboard desde el bot ---
# Si GRAFANA_URL y GRAFANA_TOKEN estan seteados, se habilita el comando !grafana.
# El bot descubre dashboards y paneles dinamicamente: agregar algo en Grafana
# se refleja en el bot sin tocar codigo. Requiere el plugin grafana-image-renderer
# instalado en el server de Grafana para poder renderizar imagenes.
GRAFANA_URL=http://192.168.1.60:3000
GRAFANA_TOKEN=              # token de un service account (rol Viewer alcanza)
GRAFANA_DEFAULT_RANGE=6h    # rango por defecto: 15m | 6h | 24h | 7d
GRAFANA_THEME=dark          # dark | light
GRAFANA_TZ=browser          # zona horaria del render (ej: America/Argentina/Buenos_Aires)
# grafana-image-renderer impone un piso de 1000x500: pedir menos devuelve
# igual una imagen de 1000x500. Achicar estos valores no tiene efecto; agrandar si.
GRAFANA_PANEL_WIDTH=1000
GRAFANA_PANEL_HEIGHT=500
GRAFANA_DASH_WIDTH=1200
GRAFANA_DASH_HEIGHT=1400

# El Guardian Report renderiza el Fleet Overview COMPLETO y divide el PNG alto
# en paginas legibles para Discord (sin perder paneles ni series historicas).
GRAFANA_GUARDIAN_ENABLED=true
GRAFANA_GUARDIAN_DASHBOARD=fleet-overview
GRAFANA_GUARDIAN_RANGE=6h
GRAFANA_GUARDIAN_WIDTH=1600
GRAFANA_GUARDIAN_HEIGHT=1600
GRAFANA_GUARDIAN_PAGE_HEIGHT=900
