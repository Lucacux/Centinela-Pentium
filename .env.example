DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
SERVER_NAME=pentium
DEBUG_MODE=false
BACKUP_PATH=/path/to/backup
SAFE_SUBNETS=192.168.,10.,172.
WATCHED_SERVICES=service1,service2
# Servicios que !restart puede tocar. Nombres de SERVICIO, no de contenedor: bajo
# Swarm el nombre real lleva un task id que cambia en cada deploy y nunca
# matchearia. Vacio = sin lista blanca (cualquier servicio que exista se puede
# reiniciar); el nombre siempre se resuelve contra lo que Docker reporta, asi que
# vacio no significa que se pueda ejecutar cualquier cosa.
ALLOWED_RESTART=service1,service2
SSH_FAIL_THRESHOLD=10
SSH_FAIL_WINDOW=120
SWAP_ALERT_PCT=80
TEMP_ALERT_C=75
MANAGED_SERVICES=service1,service2

# --- Grafana (opcional): ver los paneles del dashboard desde el bot ---
# Si GRAFANA_URL y GRAFANA_TOKEN estan seteados, se habilita el comando !grafana.
# El bot descubre dashboards y paneles dinamicamente: agregar algo en Grafana
# se refleja en el bot sin tocar codigo. Requiere el plugin grafana-image-renderer
# instalado en el server de Grafana para poder renderizar imagenes.
GRAFANA_URL=http://192.168.1.60:3000
GRAFANA_TOKEN=              # token de un service account (rol Viewer alcanza)
GRAFANA_DEFAULT_RANGE=6h    # rango por defecto: 15m | 6h | 24h | 7d
GRAFANA_THEME=dark          # dark | light
GRAFANA_TZ=browser          # zona horaria del render (ej: America/Argentina/Buenos_Aires)
# grafana-image-renderer impone un piso de 1000x500: pedir menos devuelve
# igual una imagen de 1000x500. Achicar estos valores no tiene efecto; agrandar si.
GRAFANA_PANEL_WIDTH=1000
GRAFANA_PANEL_HEIGHT=500
GRAFANA_DASH_WIDTH=1200
GRAFANA_DASH_HEIGHT=1400

# El Guardian Report agrega, en el mismo mensaje, el panel de estado de la
# flota. Los defaults coinciden con "Fleet Overview" / "Estado de nodos".
GRAFANA_GUARDIAN_ENABLED=true
GRAFANA_GUARDIAN_DASHBOARD=fleet-overview
GRAFANA_GUARDIAN_PANEL=Estado de nodos
GRAFANA_GUARDIAN_RANGE=15m
GRAFANA_GUARDIAN_WIDTH=1200
GRAFANA_GUARDIAN_HEIGHT=700

# --- DIAGNOSTICO DE RED (netdiag.py) ---
# El Centinela solo OBSERVA la red: diagnostica y reporta. Quien reinicia el ONU
# sigue siendo el ISP Uplink Guardian; aca se lo consulta de solo lectura.
ISP_GUARDIAN_URL=http://192.168.2.40:8099   # vacio = se pierde la capa ONU, el resto anda igual
NET_DNS_PROBE=cloudflare.com                # nombre a resolver para probar DNS
NET_DNS_EXTERNAL=1.1.1.1                    # resolver de contraste: separa "mi DNS roto" de "no hay DNS"
NET_WAN_IPS=1.1.1.1,8.8.8.8                 # dos proveedores: un anycast caido no es "se fue internet"
NET_HTTP_PROBE=https://www.gstatic.com/generate_204
NET_HTTP_EXPECT=204                         # otra cosa = captive portal / proxy transparente
# El gateway de esta red DESCARTA ICMP: la capa de enlace se confirma por ARP y
# por TCP contra estos puertos antes de recurrir al ping.
NET_GATEWAY_PORTS=53,80,443

# --- SPEEDTEST ---
SPEEDTEST_ENABLED=true
SPEEDTEST_EVERY_HOURS=6
SPEEDTEST_COOLDOWN_MIN=10       # cada corrida usa ~40 MB del enlace que mide
SPEEDTEST_TIMEOUT=120
# Servidor FIJO. La auto-seleccion devuelve servidores en Brasil a 3400 km y
# cambia entre corridas: sin fijarlo, los numeros no son comparables y cualquier
# umbral de "internet lento" da falsos positivos. `speedtest-cli --list` los lista.
SPEEDTEST_SERVER_ID=
SPEEDTEST_HISTORY_FILE=speedtest_history.json
# Umbrales como fraccion de tu mediana historica. Medido en esta conexion: tres
# corridas contra el MISMO servidor dieron 15.2/18.6/19.2 Mbps en dos minutos
# (26% de dispersion), y 24.9 media hora antes. Con ese ruido, umbrales
# apretados = alertas falsas. Solo "slow" postea alerta.
SPEEDTEST_SLOW_RATIO=0.45
SPEEDTEST_DEGRADED_RATIO=0.6
SPEEDTEST_MIN_SAMPLES=5

# --- MODO SILENCIO (alerts.py) ---
# De noche solo pasan las alarmas criticas (cpu, ram, disco, temp). Las de
# severidad warning y las recuperaciones esperan a la manana: despertarte para
# avisar que algo YA se arreglo es el peor aviso posible.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=1
QUIET_HOURS_END=8
